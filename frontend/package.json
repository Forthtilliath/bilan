{
  "name": "bilan-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:coverage": "ng test --watch=false --coverage",
    "lint": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.css\"",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\"",
    "format": "prettier --write \"src/**/*.{ts,html,css}\"",
    "audit": "npm audit --audit-level=high"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@forthtilliath/ts-kit": "^0.16.0",
    "@forthtilliath/ts-types": "^0.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.5",
    "@forthtilliath/eslint-config": "^0.10.2",
    "@forthtilliath/typescript-config": "^0.1.1",
    "@vitest/coverage-v8": "^5.1.0",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "~6.0.2",
    "vitest": "^5.1.0"
  }
}
